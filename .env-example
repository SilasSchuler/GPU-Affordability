# Copy this file to .env and fill every empty value. Required:

# MINIO_SECRET, POSTGRES_PASSWORD, PGADMIN_DEFAULT_EMAIL,
# PGADMIN_DEFAULT_PASSWORD. Never commit .env.
MINIO_ADMIN=minioadmin
MINIO_SECRET=
# Use http://objectstorage:9000 inside the docker network,
# http://localhost:9000 when running scripts on the host with `uv run`.
MINIO_ENDPOINT=http://localhost:9000
POSTGRES_DB=gpu
POSTGRES_USER=sharedUser
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=8085

# Kestra (orchestrator)
KESTRA_USER=student@example.com
KESTRA_PASSWORD=
KESTRA_PORT=8081

# Ingestion Settings
# The smallest samples have slightly over 1000 values
MIN_EXPECTED_ROWS=1000
